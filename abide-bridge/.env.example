# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Abide
ABIDE_TIMEZONE=America/Chicago

# WhatsApp Cloud API — leave blank during simulator testing.
META_GRAPH_VERSION=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Only these two WhatsApp accounts are allowed to use the bridge.
# Digits only or +E.164 are both accepted.
TYLER_WHATSAPP_E164=
ELIZABETH_WHATSAPP_E164=

# Phase 1 intentionally does NOT write to Abide yet.
ABIDE_BRIDGE_DRY_RUN=true
PORT=8787

# Phase 2B — local trusted Firebase Admin connection.
# Use `npm run configure:firebase`; do not paste key material into chat.
FIREBASE_PROJECT_ID=abide-809d9
ABIDE_TARGET_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=
