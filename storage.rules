rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /*
     * Each authenticated Abide user may access only
     * files stored beneath their own user directory.
     *
     * Workspace uploads currently use:
     * users/{uid}/blocks/...
     */
    match /users/{userId}/{allPaths=**} {
      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
